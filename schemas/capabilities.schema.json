{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "officecli/capabilities/v1",
  "title": "OfficeCLI Capabilities",
  "type": "object",
  "required": ["schemaVersion", "officeCliVersion", "os", "architecture", "runtimeIdentifier", "renderers", "validationProfiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "officeCliVersion": { "type": "string" },
    "os": { "type": "string" },
    "architecture": { "type": "string" },
    "runtimeIdentifier": { "type": "string" },
    "renderers": { "type": "object", "required": ["nativePowerPoint", "nativeWord", "htmlScreenshot", "mermaidImage"], "additionalProperties": { "$ref": "#/$defs/renderer" } },
    "validationProfiles": { "type": "array", "items": { "enum": ["schema", "strict-opc", "ios-preview"] }, "uniqueItems": true }
  },
  "additionalProperties": false,
  "$defs": { "renderer": { "type": "object", "required": ["available"], "properties": { "available": { "type": "boolean" }, "reason": { "type": ["string", "null"] }, "backends": { "type": ["array", "null"], "items": { "type": "string" } } }, "additionalProperties": false } }
}
